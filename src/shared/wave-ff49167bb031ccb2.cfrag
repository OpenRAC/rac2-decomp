extern float @@ROLE_0_00@@ (float x, int a1, float y);
extern float @@ROLE_1_00@@ (float x, float y);
extern float @@ROLE_2_00@@ (float x, int a1, float y);

void @@FUNCTION@@ (float *p, int a1, float fx, float fl)
{
  float v;

  v = @@ROLE_0_01@@ (fx, a1, p[0]);
  if (fl < v)
    v = fl;
  else if (v < -fl)
    v = -fl;
  v = @@ROLE_1_01@@ (p[0], v);
  p[0] = v;
  @@ROLE_2_01@@ (fx, a1, v);
}
