+              expressionS seed = lo32;
+              seed.X_op = O_constant;
+              seed.X_add_number = (offsetT) -1;
+              seed.X_unsigned = 0;
+              macro_build ((char *) NULL, counter, &seed, "addiu", "t,r,j",
+                           reg, 0, (int) BFD_RELOC_LO16);
+            }
+          else
+            macro_build ((char *) NULL, counter, &lo32, "lui", "t,u", reg,
