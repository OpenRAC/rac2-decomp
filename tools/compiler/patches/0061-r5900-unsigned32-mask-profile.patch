 /* Select the measured seed for the R5900 isolated sign-bit constant. */
 static int r5900_sign_bit_signed = 1;
+
+/* Preserve GNU unsigned32-mask seeds unless a unit selects the SN profile. */
+static int r5900_unsigned32_mask_sn = 0;

 /* The argument of the -mabi= flag. */
 static char* mips_abi_string = 0;
@@ -3308,8 +3311,21 @@

       if ((freg == 0) && (lo32.X_add_number == 0xffffffff))
         {
-	  macro_build ((char *) NULL, counter, &lo32, "lui", "t,u", reg,
